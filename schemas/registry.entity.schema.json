{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/registry.entity.schema.json",
  "title": "IndiceIA Entity Templates Registry",
  "type": "object",
  "required": ["registry_version", "last_updated", "templates"],
  "properties": {
    "registry_version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date-time" },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "version", "entrypoint"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "entrypoint": {
            "type": "string",
            "description": "Ruta interna al template base"
          },
          "supports": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          },
          "requirements": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
