{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/registry.entity.schema.json",
  "title": "IndiceIA Entity Templates Registry",
  "type": "object",
  "required": ["registry_version", "last_updated", "templates"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "version", "entrypoint"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "description": "Ruta interna al template base"
          },
          "supports": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "boolean" }
          },
          "requirements": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
