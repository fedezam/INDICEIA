{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/registry.visual.schema.json",
  "title": "IndiceIA Visual Templates Registry",
  "type": "object",
  "required": [
    "registry_version",
    "last_updated",
    "templates"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "tier",
          "description",
          "ideal_for",
          "visual",
          "previews"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "tier": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "ideal_for": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "visual": {
            "type": "object",
            "required": [
              "iframe_url"
            ],
            "properties": {
              "iframe_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "previews": {
            "type": "object",
            "properties": {
              "thumbnail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
