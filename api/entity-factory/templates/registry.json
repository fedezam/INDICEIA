  "template_selection_logic": {
    "description": "Lógica para que el AutoBuilder seleccione template automáticamente",
    
    "rules": [
      {
        "condition": "tipo_negocio IN ['pizzería', 'restaurante', 'cafetería', 'bar', 'panadería']",
        "recommended_template": "C1_Napolitana",
        "confidence": "high"
      },
      {
        "condition": "tipo_negocio IN ['automotriz', 'inmobiliaria', 'mueblería']",
        "recommended_template": "C2_CatalogoVisual",
        "confidence": "high"
      },
      {
        "condition": "items[].images.length > 1 (most products have multiple images)",
        "recommended_template": "C2_CatalogoVisual",
        "confidence": "medium"
      },
      {
        "condition": "items[].precio_mediana EXISTS (multiple size variants)",
        "recommended_template": "C1_Napolitana",
        "confidence": "medium"
      },
      {
        "condition": "DEFAULT fallback",
        "recommended_template": "C1_Napolitana",
        "confidence": "low"
      }
    ]
  },
  
