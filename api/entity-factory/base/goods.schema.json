{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/goods.schema.json",
  "title": "Goods – Catálogo de Productos",
  "description": "Productos del comercio. Universo cerrado: si un producto no está aquí, no existe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "secciones"],
  "properties": {
    "enabled": { "type": "boolean" },
    "moneda": {
      "type": "string",
      "enum": ["ARS", "USD", "EUR", "BRL", "CLP", "UYU", "PEN", "COP", "MXN"],
      "default": "ARS"
    },
    "secciones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/seccion" }
    }
  },
  "$defs": {
    "seccion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titulo", "tipo", "prioridad", "items"],
      "properties": {
        "id":       { "type": "string" },
        "titulo":   { "type": "string" },
        "tipo":     { "type": "string", "enum": ["grid", "lista", "carousel"] },
        "prioridad":{ "type": "number", "minimum": 1 },
        "items":    { "type": "array", "items": { "$ref": "#/$defs/producto" } }
      }
    },
    "producto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "precio_final"],
      "properties": {
        "id":           { "type": "string" },
        "nombre":       { "type": "string" },
        "descripcion":  { "type": "string" },
        "codigo":       { "type": "string" },
        "categoria":    { "type": "string" },
        "subcategoria": { "type": "string" },
        "marca":        { "type": "string" },
        "precio_final": { "type": "number", "minimum": 0 },
        "stock":        { "type": "number", "minimum": 0 },
        "disponibilidad": {
          "type": "string",
          "enum": ["inmediata", "bajo_pedido", "sin_stock"]
        },
        "imagen":   { "type": "string", "format": "uri" },
        "etiquetas":{ "type": "array", "items": { "type": "string" } },
        "atributos":{ "type": "object", "additionalProperties": true },
        "paused":   { "type": "boolean", "default": false }
      }
    }
  }
}
