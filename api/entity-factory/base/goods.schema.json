{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/goods.schema.json",
  "title": "Goods – Catálogo de Productos",
  "description": "Universo cerrado de productos. Estructura canónica consumida por templates visuales via postMessage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goods"],
  "properties": {
    "goods": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre"],
      "properties": {
        "id":            { "type": "string" },
        "nombre":        { "type": "string" },
        "precio_final":  { "type": "number", "minimum": 0 },
        "descripcion":   { "type": "string" },
        "categoria":     { "type": "string" },
        "subcategoria":  { "type": "string" },
        "marca":         { "type": "string" },
        "imagen":        { "type": "string" },
        "stock":         { "type": "number", "minimum": 0 },
        "disponibilidad": {
          "type": "string",
          "enum": ["inmediata", "bajo_pedido", "sin_stock"]
        },
        "etiquetas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variantes": {
          "type": "array",
          "items": { "$ref": "#/$defs/variante" }
        }
      }
    },
    "variante": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "precio"],
      "properties": {
        "id":    { "type": "string" },
        "label": { "type": "string" },
        "precio":{ "type": "number", "minimum": 0 }
      }
    }
  }
}
