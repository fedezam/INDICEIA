{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/services.schema.json",
  "title": "Services – Catálogo de Servicios",
  "description": "Servicios que ofrece el comercio. Universo cerrado: si un servicio no está aquí, no existe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "servicios"],
  "properties": {
    "enabled": { "type": "boolean" },
    "servicios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/servicio" }
    }
  },
  "$defs": {
    "servicio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "modalidad", "disponibilidad", "activo"],
      "properties": {
        "id":          { "type": "string" },
        "nombre":      { "type": "string" },
        "descripcion": { "type": "string" },
        "modalidad": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["presencial", "a_domicilio", "remoto"] },
          "description": "Cómo se presta el servicio. Puede tener una o varias modalidades."
        },
        "disponibilidad": { "type": "string", "enum": ["inmediata", "a_coordinar"] },
        "activo": { "type": "boolean" },
        "precio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo"],
          "properties": {
            "tipo":   { "type": "string", "enum": ["fijo", "desde", "presupuesto", "consultar"] },
            "valor":  { "type": "number", "minimum": 0 },
            "moneda": { "type": "string", "default": "ARS" }
          }
        },
        "duracion_minutos": { "type": "number", "minimum": 1 },
        "variantes": { "type": "array", "items": { "type": "string" } },
        "notas":     { "type": "string" }
      }
    }
  }
}
