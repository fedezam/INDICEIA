{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/bloqueB.schema.json",
  "title": "Bloque B – Entidad Comercial Runtime (ÍndiceIA)",
  "description": "Contrato runtime del Bloque B. Solo valida datos existentes. No fuerza campos ni estructura.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "nombre": { "type": "string", "minLength": 1 },
    "descripcion": { "type": "string", "minLength": 1 },
    "direccion": { "type": "string", "minLength": 1 },
    "telefono": { "type": "string", "minLength": 1 },
    "categoria": { "type": "string", "minLength": 1 },
    "plan": { "type": "string", "minLength": 1 },
    "horarios": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/diaHorario"
      }
    },
    "catalogo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moneda": {
          "type": "string",
          "enum": ["ARS", "USD", "EUR"]
        },
        "secciones": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/seccionCatalogo" }
        }
      }
    },
    "pagos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metodosDisponibles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "descuentos": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "aceptaTarjeta": { "type": "boolean" },
        "aceptaDigital": { "type": "boolean" }
      }
    },
    "envios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disponible": { "type": "boolean" },
        "zonasGratis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "zonasCosto": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "costoMinimo": { "type": "number" },
        "deliveryPropio": { "type": "boolean" }
      }
    },
    "imagenes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "seccionCatalogo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titulo", "tipo", "prioridad", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "titulo": { "type": "string", "minLength": 1 },
        "tipo": {
          "type": "string",
          "enum": ["grid", "lista", "carousel"]
        },
        "prioridad": {
          "type": "number",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/producto" }
        }
      }
    },
    "producto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "precio_final", "paused"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "codigo": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "descripcion": { "type": "string" },
        "categoria": { "type": "string" },
        "precio_final": { "type": "number", "minimum": 0 },
        "imagen": { "type": "string", "format": "uri" },
        "stock": { "type": "number" },
        "paused": { "type": "boolean" },
        "etiquetas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "atributos": {
          "type": "object",
          "description": "Campos libres definidos por el comercio (marca, talle, color, material, etc.)",
          "additionalProperties": true
        },
        "destacado": {
          "type": ["boolean", "string"],
          "description": "Si existe, indica que el producto es destacado. Puede ser true (genérico) o un string con motivo (ej. 'Oferta 20%', 'Nuevo', 'Recomendado')."
        }
      }
    },
    "diaHorario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed"],
      "properties": {
        "closed": { "type": "boolean" },
        "continuous": { "type": "boolean" },
        "morning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "open": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "close": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          }
        },
        "afternoon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "open": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "close": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          }
        }
      }
    }
  }
}
