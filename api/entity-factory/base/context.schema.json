{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiceia.com/schemas/context.schema.json",
  "title": "Context – Identidad del Comercio",
  "description": "Quién es el comercio y cómo opera. Base de identidad para el LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nombre"],
  "properties": {
    "id":          { "type": "string" },
    "nombre":      { "type": "string", "description": "Desde: nombreComercio" },
    "descripcion": { "type": "string" },
    "categorias":  { "type": "array", "items": { "type": "string" }, "description": "Desde: categories" },
    "ubicacion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direccion": { "type": "string" },
        "ciudad":    { "type": "string" },
        "provincia": { "type": "string" },
        "pais":      { "type": "string" }
      }
    },
    "contacto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whatsapp":  { "type": "string" },
        "telefono":  { "type": "string" },
        "email":     { "type": "string" },
        "website":   { "type": "string" },
        "instagram": { "type": "string" },
        "facebook":  { "type": "string" },
        "tiktok":    { "type": "string" }
      }
    },
    "horarios": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/diaHorario" }
    },
    "pagos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metodosDisponibles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Desde: paymentMethods"
        }
      }
    },
    "ia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre":      { "type": "string", "description": "Desde: aiConfig.identidad.nombre" },
        "saludo":      { "type": "string", "description": "Desde: aiConfig.identidad.saludo" },
        "idioma":      { "type": "string", "description": "Desde: aiConfig.identidad.idioma" },
        "personalidad":{ "type": "string", "enum": ["amigable", "formal", "vendedor"] },
        "tono":        { "type": "string", "enum": ["informal", "neutral", "formal"] },
        "comportamiento": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proactividad":      { "type": "string", "enum": ["bajo", "medio", "alto"] },
            "formatoRespuestas": { "type": "string", "enum": ["cortas", "detalladas"] }
          }
        },
        "contingencias": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sinPrecio":    { "type": "string", "enum": ["informar", "consultar"] },
            "sinStock":     { "type": "string", "enum": ["informar", "ofrecerAlternativa"] },
            "localCerrado": { "type": "string", "enum": ["informar", "tomarMensaje"] }
          }
        }
      }
    },
    "plan":               { "type": "string", "description": "Desde: plan.type" },
    "templateId":         { "type": "string" },
    "templateUpdatedAt":  { "type": "string", "format": "date-time" },
    "referral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code":         { "type": "string" },
        "shareMessage": { "type": "string" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "diaHorario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed"],
      "properties": {
        "closed":     { "type": "boolean" },
        "continuous": { "type": "boolean" },
        "open":       { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "close":      { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "morning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "open":    { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
            "close":   { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
          }
        },
        "afternoon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "open":    { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
            "close":   { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
          }
        }
      }
    }
  }
}
