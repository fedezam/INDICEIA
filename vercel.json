{
  "functions": {
    "api/export-json.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/link-builder/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  {
  "routes": [
    {
      "src": "^/c/([^/]+)$",
      "dest": "/api/link-builder?comercio_id=$1"
    },
    {
      "src": "^/bot/([^/]+)$",
      "dest": "/api/link-builder?comercio_id=$1"
    },

    { "handle": "filesystem" },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
